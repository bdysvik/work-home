rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          currentUserDoc().data.role == 'admin' ||
          currentUserDoc().data.role == 'ADMIN'
        );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function choreIsOpen(choreData) {
      return choreData.assignedTo == null || choreData.assignedTo == '';
    }

    function sameProfileFields() {
      return request.resource.data.get('name', '') == resource.data.get('name', '')
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('authUid', '') == resource.data.get('authUid', '');
    }

    function isValidSelfAssignment() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && resource.data.active == true
        && changedKeys.hasOnly(['assignedTo'])
        && choreIsOpen(resource.data)
        && request.resource.data.assignedTo == request.auth.uid;
    }

    function isValidCompletionBackedRewardUpdate(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let completionId = request.resource.data.lastCompletionId;
      let completionPath = /databases/$(database)/documents/completions/$(completionId);
      return isSelf(userId)
        && sameProfileFields()
        && completionId is string
        && changedKeys.hasOnly(['currentRewardTotal', 'lastCompletionId', 'lastCompletedAt'])
        && existsAfter(completionPath)
        && getAfter(completionPath).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.currentRewardTotal == 0
        && request.resource.data.lastCompletionId == "";
      allow update: if isAdmin()
        || isValidCompletionBackedRewardUpdate(userId);
      allow delete: if isAdmin();
    }

    match /pendingUsers/{emailKey} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSignedIn();
    }

    match /chores/{choreId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidSelfAssignment();
    }

    match /choreTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rewardHistory/{historyId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /completions/{completionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reward is int
        && request.resource.data.reward >= 0
        && request.resource.data.choreId is string;
      allow update, delete: if isAdmin();
    }
  }
}
